# ==========================================
# Kenzo Treasury — Environment Variables Example
# ==========================================

# 1. Database Connection (Supabase PostgreSQL / Pooler)
# Port 6543 untuk transaction pooler (Server Actions / App Runtime)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require"
# Port 5432 untuk direct unpooled connection (Drizzle Kit CLI Migration / DDL)
DATABASE_URL_UNPOOLED="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require"

# 2. Supabase API Credentials (Client & Server SSR)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key-here"

# 3. Supabase Service Role (Server-only / Elevated Permissions)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# 4. Google GenAI (Gemini 1.5 Flash untuk Evaluasi Bulanan)
GEMINI_API_KEY="your-gemini-api-key-here"
