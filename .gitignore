# ==========================================
# Kenzo Treasury — Git Ignore Rules
# ==========================================

# 1. Environment variables & secrets
.env
.env.*
!.env.example
env.production.local
*.pem
*.key
*.p12
*.pfx

# 2. Dependencies
node_modules/
.pnp
.pnp.js

# 3. Next.js & Build Outputs
.next/
out/
build/
dist/
*.tsbuildinfo
next-env.d.ts

# 4. PWA / Service Worker Generated Artifacts (@ducanh2912/next-pwa)
public/sw.js
public/workbox-*.js
public/worker-*.js
public/fallback-*.js
public/swe-worker-*.js

# 5. Temporary & Ad-hoc Scratch Work
scratch/
.runtime/
.tests-backup/

# 6. Debug & Package Manager Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Vercel & Deployment
.vercel/

# 8. Operating System & IDE Caches
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
